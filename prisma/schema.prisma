generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model game_scores {
  player_id     String   @db.Uuid
  variant       String
  best_score    Int      @default(0)
  best_wpm      Int      @default(0)
  best_accuracy Int      @default(0)
  plays         Int      @default(0)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  players       players  @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([player_id, variant])
  @@index([variant, best_score(sort: Desc)], map: "game_scores_variant_score_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model level_progress {
  player_id  String   @db.Uuid
  game_id    String   @default("mario-khmer-quest")
  level      Int
  stars      Int      @default(0)
  best_score Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  players    players  @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([player_id, game_id, level])
}

model player_settings {
  player_id  String   @id @db.Uuid
  settings   Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  players    players  @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model players {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_id       String           @unique @db.Uuid
  user_id         String?          @unique(where: raw("(user_id IS NOT NULL)")) @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  game_scores     game_scores[]
  level_progress  level_progress[]
  player_settings player_settings?
  users           users?           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  practice_bests  practice_bests[]
  key_stats       key_stats[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model practice_bests {
  player_id     String   @db.Uuid
  language      String
  best_wpm      Int      @default(0)
  best_accuracy Int      @default(0)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
  players       players  @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([player_id, language])
}

model schema_migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model auth_throttle {
  key          String   @id
  attempts     Int      @default(0)
  window_start DateTime @default(now()) @db.Timestamptz(6)
}

model sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String     @unique
  password_hash String
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  players       players?
  sessions      sessions[]
}

/// Per-key typing history (weak-keys report). Each device writes its own totals; readers sum the other devices.
model key_stats {
  player_id  String   @db.Uuid
  device_id  String   @db.Uuid
  language   String
  ch         String
  attempts   Int      @default(0)
  errors     Int      @default(0)
  total_ms   Int      @default(0)
  timed      Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  players    players  @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([player_id, device_id, language, ch])
}
